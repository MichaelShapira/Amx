# bench-thin:torch-cpu and bench-thin:torch-cuda (design 7.5).
# Build from the repository root:
#   docker build -f servers/thin/Dockerfile.torch --build-arg BASE_IMAGE=<cpu or cuda digest> .
# torch comes from the AWS Deep Learning Container base; everything else is pinned with
# hashes in requirements-torch.lock.
# checkov:skip=CKV_DOCKER_7: BASE_IMAGE is always a digest-pinned reference (the default below, or config/images.yaml)
ARG BASE_IMAGE=public.ecr.aws/deep-learning-containers/pytorch:2.14.0-cpu-amzn2023@sha256:e9aa07c11afc5f7eff183782cf3dde397012e2f08ab700dffd2828203688c159
FROM ${BASE_IMAGE}

WORKDIR /app
COPY servers/thin/requirements-torch.lock /app/requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes --no-deps -r /app/requirements.lock \
    && python -c "import torch, transformers; print('torch', torch.__version__, 'transformers', transformers.__version__)"

COPY servers/__init__.py /app/servers/__init__.py
COPY servers/thin /app/servers/thin

# Models are mounted read-only at /models; nothing is downloaded at run time.
# The server runs as a user with no home directory. Every library that caches under ~ (Triton's kernel
# cache on the CUDA build, torch.compile's inductor cache, Hugging Face) is pointed at /tmp, which the
# container always has: Flan-T5 on the GPU failed its first request with
# "PermissionError: [Errno 13] Permission denied: '/home/bench'" from triton/runtime/cache.py (2026-11-20).
ENV PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    THIN_HOST=127.0.0.1 THIN_PORT=8000 \
    HOME=/tmp XDG_CACHE_HOME=/tmp/cache TRITON_CACHE_DIR=/tmp/cache/triton TORCHINDUCTOR_CACHE_DIR=/tmp/cache/inductor \
    HF_HOME=/tmp/cache/huggingface
RUN useradd --uid 10001 --no-create-home --shell /sbin/nologin bench && mkdir -p /tmp/cache && chmod 1777 /tmp /tmp/cache
USER 10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=3 \
    CMD ["python", "-c", "import os, urllib.request; urllib.request.urlopen(f\"http://127.0.0.1:{os.environ.get('THIN_PORT', '8000')}/health\", timeout=4)"]
ENTRYPOINT []
CMD ["python", "-m", "servers.thin.app"]
