# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Editor / OS noise
.DS_Store
.idea/
.vscode/

# Credentials and secrets: never commit
.env
*.pem
*creds*.sh

# Build outputs
build/
cdk.out/
infra/cdk.out/
infra/node_modules/
webui/dist/
webui/node_modules/
webui/tsconfig.tsbuildinfo

# CDK context cache: holds the deploying account's id and AZ list; the CLI regenerates it
infra/cdk.context.json

# cdk --outputs-file targets; the CLI and the app read CloudFormation directly
deployment/

# Generated data. The DSPM dataset contains realistic fake secrets and identifiers that
# secret scanners flag; it lives in S3 and in data/ locally, never in git.
data/
prompts/generated/

# Local run outputs and screenshots
/runs/
reports/local/
webui/.shots/

# Scanner working directories
.protoshield/
.holmes/
