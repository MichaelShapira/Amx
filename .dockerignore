# Docker build context for the thin-server, export and web-app images: code only. The web app
# image (webui/Dockerfile) adds bench/, lambdas/, tools/, config/ and the front-end sources; never the
# local node_modules, dist, data, credentials or git history.
*
!servers/__init__.py
!servers/thin/**
!servers/export/**
!servers/decider/**
!bench/**
!lambdas/**
!tools/**
!config/**
!host/**
!docs/architecture.svg
!docs/architecture.drawio
!webui/__init__.py
!webui/api/**
!webui/src/**
!webui/index.html
!webui/vite.config.ts
!webui/tsconfig.json
!webui/package.json
!webui/package-lock.json
!webui/requirements.lock
!webui/Dockerfile
**/__pycache__
**/*.pyc
**/.pytest_cache
